# AI is OPTIONAL and all-or-nothing: set all three AI_* values to get the
# sarcastic 4-hour reports, or leave all three empty/removed to run without AI
# commentary (status updates and the dashboard still work).
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
DB_PATH=metrics.sql

# Notifier backend: "telegram" (default if unset), "discord", "ntfy", or "none".
#   telegram / discord / ntfy -> pushes status updates & reports to that service
#   none                       -> dashboard-only: nothing is pushed out; view
#                                 results on the web page (requires WEB_ENABLED=true)
NOTIFIER=telegram

# Required when NOTIFIER=telegram
TG_BOT_TOKEN=123456:AA...
TG_CHAT_ID=123456789

# Optional: use Discord instead of Telegram.
# Set NOTIFIER=discord and fill this in — the TG_* vars are then not required.
# Get the URL in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123.../abc...

# Optional: use ntfy (https://ntfy.sh, or a self-hosted server) instead.
# Set NOTIFIER=ntfy and give the full topic URL. Auth is only needed for
# protected topics — use EITHER a bearer access token OR a username/password
# pair (not both). A public/unreserved topic needs no auth at all.
# NTFY_URL=https://ntfy.sh/your-unique-netmon-topic
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxx
# NTFY_USER=myuser
# NTFY_PASSWORD=mypassword

# Optional: HTTP timeout in seconds for Telegram/Discord requests (must be positive, default 10)
# REQUEST_TIMEOUT=30

# --- Web dashboard ---
# A local web page showing the latest metrics, 24h graph, device list, history,
# a "run speed test now" button, and a CSV export. Runs alongside notifiers.
# WEB_ENABLED=true            # set to false to disable the web dashboard
# WEB_HOST=0.0.0.0            # bind address (use 127.0.0.1 to restrict to localhost)
# WEB_PORT=8080              # port to serve the dashboard on

# --- Admin page (optional) ---
# Set BOTH to enable an authenticated /admin page for editing the schedule
# (interval, active hours/days), report frequency, the status-message template,
# and the AI system prompt. Left unset, the admin page is disabled.
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me
